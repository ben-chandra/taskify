generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PRODUCT_MANAGER
  ENGINEER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum NotificationType {
  TASK_CREATED
  TASK_MOVED
  TASK_ASSIGNED
  TASK_UNASSIGNED
  COMMENT_ADDED
  COMMENT_EDITED
  COMMENT_DELETED
}

// Fixed, seeded set of exactly 5 rows; no create/update/delete API (FR-001).
model User {
  id   String @id @default(uuid())
  name String @unique
  role Role

  createdProjects Project[]      @relation("ProjectCreatedBy")
  assignedTasks    Task[]        @relation("TaskAssignee")
  comments         Comment[]
  notifications    Notification[]
}

model Project {
  id              String   @id @default(uuid())
  // Unique case-insensitively (FR-004) - enforced at the application layer
  // via a citext-equivalent check, since Postgres `UNIQUE` on `name` alone
  // is case-sensitive.
  name            String   @unique
  createdByUserId String
  createdBy       User     @relation("ProjectCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime @default(now())

  tasks         Task[]
  notifications Notification[]
}

model Task {
  id              String     @id @default(uuid())
  projectId       String
  project         Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  status          TaskStatus @default(TODO)
  assigneeUserId  String?
  assignee        User?      @relation("TaskAssignee", fields: [assigneeUserId], references: [id])
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  comments Comment[]

  @@index([projectId])
}

model Comment {
  id            String    @id @default(uuid())
  taskId        String
  task          Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorUserId  String
  author        User      @relation(fields: [authorUserId], references: [id])
  text          String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime?

  @@index([taskId])
}

model Notification {
  id            String           @id @default(uuid())
  projectId     String
  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type          NotificationType
  actingUserId  String
  actingUser    User             @relation(fields: [actingUserId], references: [id])
  payload       Json
  createdAt     DateTime         @default(now())

  @@index([projectId, createdAt])
}
